# SPDX-License-Identifier: EUPL-1.2
# /etc/lnsd/config — Leviculum lnsd on a 4G stick: a plain client, no transport.
# Set your transport node at the bottom, then: sudo systemctl enable --now lnsd
[reticulum]
  enable_transport = No
  share_instance = Yes
  # lets lnstatus authenticate (dongie's Reticulum tab): lnsd keeps its storage in a
  # tmpfs the tools can't see. Same key in /etc/dongie/reticulum/config.
  # @RPC_KEY@ is replaced with a random key the first time lnsd starts
  # (/usr/local/sbin/lnsd-setup); to make one yourself:
  #   head -c 32 /dev/urandom | od -An -tx1 | tr -d " \n"
  rpc_key = @RPC_KEY@
  # small tables (4096 destinations, 8192 paths), and fewer still
  storage_profile = compact
  max_known_destinations = 2000
  # paths not refreshed for a day are dropped (Python default: a week)
  path_expiry_secs = 86400
  # collect no interface announcements from other nodes (Leviculum defaults
  # to yes, Python to no): nothing to do with them on a stick
  discover_interfaces = No

[logging]
  # 2 = warnings: little journal traffic (flash)
  loglevel = 2

[interfaces]
  [[transport node]]
    type = TCPClientInterface
    interface_enabled = yes
    target_host = your-transport-node.example.org
    target_port = 4242
